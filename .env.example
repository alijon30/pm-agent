# Copy to .env. Load with: uv run --env-file .env <command>
# GOOGLE_API_KEY is the only required credential. Empty = that feature is off, not a crash.

GOOGLE_API_KEY=                            # https://aistudio.google.com/apikey
GOOGLE_GENAI_USE_VERTEXAI=FALSE            # TRUE routes Gemini through Vertex AI
PM_MODEL_FAST=gemini-3.5-flash-lite
PM_MODEL_STRONG=gemini-3.5-flash
PM_MODEL_TRIAGE=gemma-4-31b-it

PM_GCP_PROJECT=demo                        # Firestore project; "demo" works with the emulator
PM_FIRESTORE_DATABASE=(default)
PM_DEFAULT_PROJECT_SLUG=acme
PM_TICK_TOKEN=dev-tick-token               # shared secret for POST /tick
PM_FATHOM_WEBHOOK_SECRET=whsec_ZGVtbw==    # send_call.py signs with this same value

# Optional connectors
PM_LINEAR_API_KEY=
PM_NOTION_TOKEN=
PM_SLACK_BOT_TOKEN=
PM_SLACK_SIGNING_SECRET=
PM_GITHUB_TOKEN=
PM_GITHUB_REPO=
