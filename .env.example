# Copy to .env, then load with:  uv run --env-file .env <command>
#
# The short version: GOOGLE_API_KEY is the only credential you need. Everything else
# either has a working default or turns a feature off when left empty.

# --- the model ---------------------------------------------------------------------------------

# Get one free at https://aistudio.google.com/apikey — this is the only required credential.
GOOGLE_API_KEY=

# FALSE = call Gemini with the API key above. TRUE = go through Vertex AI instead, which
# bills a GCP project; then also set GOOGLE_CLOUD_PROJECT=<project id> and
# GOOGLE_CLOUD_LOCATION=global. (Gemma stays on the API key either way.)
GOOGLE_GENAI_USE_VERTEXAI=FALSE

# Which model does what. The defaults are what production runs; leave them unless you know why.
PM_MODEL_FAST=gemini-3.5-flash-lite
PM_MODEL_STRONG=gemini-3.5-flash
PM_MODEL_TRIAGE=gemma-4-31b-it

# --- storage -----------------------------------------------------------------------------------

# The GCP project whose Firestore holds the task graph. No GCP account? Run the local
# emulator (see README "Try it"), set this to any word (e.g. demo), and export
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8790 before starting the server.
PM_GCP_PROJECT=demo
PM_FIRESTORE_DATABASE=(default)

# Which project document the agent serves. scripts/seed_project.py writes "acme"; keep it.
PM_DEFAULT_PROJECT_SLUG=acme

# --- driving it locally ------------------------------------------------------------------------

# Shared secret for POST /tick (the heartbeat Cloud Scheduler normally sends). Any string.
# To advance the pipeline by hand:  curl -X POST -H "x-tick-token: <this>" localhost:8080/tick
PM_TICK_TOKEN=dev-tick-token

# scripts/send_call.py signs its webhook with this same value, so any whsec_ + base64 works.
# Leave it empty and the webhook (rightly) rejects everything with a 401.
PM_FATHOM_WEBHOOK_SECRET=whsec_ZGVtbw==

# --- optional connectors -----------------------------------------------------------------------
# Empty = that feature is off, not a crash. Stages that need one fail closed with a reason.

PM_LINEAR_API_KEY=          # Linear personal API key: issues get filed for real
PM_NOTION_TOKEN=            # Notion integration token: docs join reconciliation
PM_SLACK_BOT_TOKEN=         # xoxb- bot token: summaries, plans, standups, the revert button
PM_SLACK_SIGNING_SECRET=    # from the Slack app config: verifies inbound Slack events
PM_GITHUB_TOKEN=            # fine-grained PAT, read-only: the check_pr_* checks
PM_GITHUB_REPO=             # owner/repo those PR checks look at
